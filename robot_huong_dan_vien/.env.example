# Cấu hình khóa bí mật kết nối Google Gemini API (Lấy tại https://aistudio.google.com/)
GEMINI_API_KEY=AQ.Ab8RN6IRvOz-UQd0QUu70F14B8Ko1sqAj6inEdnXa6As1v_y_A

# Cấu hình Mô hình Ngôn ngữ (Mặc định: gemini-2.0-flash cho tốc độ phản hồi tức thì)
GEMINI_MODEL=gemini-2.0-flash

# Cấu hình Động cơ Giọng nói AI: kokoro (Giọng AI Tiếng Việt chuẩn tự nhiên) | edge-tts | gtts
TTS_ENGINE=kokoro

# Cấu hình Giọng đọc Kokoro duy nhất: mai_linh (Nữ trẻ trung, trong trẻo, tự nhiên)
KOKORO_VOICE=mai_linh
KOKORO_DEVICE=cpu

# Tốc độ đọc (1.05: Chuẩn tự nhiên, lưu loát | 0.95: Chậm rãi)
VOICE_SPEED=1.05

# Cấu hình Giọng đọc Edge-TTS
VOICE_NAME=vi-VN-HoaiMyNeural

# Cấu hình Micro & Khoảng dừng ngắt nghỉ (Tính bằng Giây - 0.8s giúp phản hồi nhanh không cần chờ lâu)
MIC_PAUSE_THRESHOLD=0.8
MIC_TIMEOUT=15
MIC_PHRASE_LIMIT=30
